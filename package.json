{
  "name": "signalhive-charts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An open-source charting workbench for technical analysis and paper trading.",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 1420",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "format": "prettier --write src scripts .github *.json *.md docs public/manifest.webmanifest",
    "format:check": "prettier --check src scripts .github *.json *.md docs public/manifest.webmanifest"
  },
  "dependencies": {
    "lightweight-charts": "5.2.1",
    "lucide-react": "^0.577.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "prettier": "3.9.10",
    "typescript": "^5.9.0",
    "vite": "8.3.4",
    "vitest": "latest"
  }
}
